
---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const entries = (await getCollection("research", ({ data }) => {
  const category = data.category.toLowerCase();

  return (
    data.draft !== true &&
    ["guide", "guides", "technical guide", "technical guides"].includes(category)
  );
})).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en", {
    day: "numeric",
    month: "short",
    year: "numeric",
  }).format(date);
---

<BaseLayout
  title="Technical Guides — Saltik Research"
  description="Practical cybersecurity guides, technical documentation and step-by-step tutorials from Saltik Research."
>
  <section class="mx-auto max-w-6xl px-6 pb-24 pt-16 sm:pt-24">
    <a
      href="/"
      class="text-sm text-slate-400 transition hover:text-blue-300"
    >
      ← Home
    </a>

    <header class="mt-12 max-w-3xl">
      <p class="eyebrow">Knowledge & Practice</p>

      <h1 class="hero-title mt-6 text-4xl font-semibold leading-tight text-white sm:text-6xl">
        Technical <span class="hero-gradient">Guides.</span>
      </h1>

      <p class="mt-6 text-base leading-8 text-slate-400 sm:text-lg">
        Practical guides, technical walkthroughs and carefully documented
        solutions for security, infrastructure and development.
      </p>

      <div class="mt-8 flex flex-wrap gap-3 text-xs text-slate-500">
        <span class="rounded-md border border-white/10 px-3 py-2">
          Step-by-step
        </span>
        <span class="rounded-md border border-white/10 px-3 py-2">
          Infrastructure
        </span>
        <span class="rounded-md border border-white/10 px-3 py-2">
          Cybersecurity
        </span>
      </div>
    </header>

    <div class="mt-20 border-t border-white/[0.08] pt-10 sm:mt-24 sm:pt-12">
      {entries.length > 0 ? (
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {entries.map((entry) => (
            <a
              href={`/research/${entry.id.replace(/\.md$/, "")}/`}
              class="glass-card group flex h-full flex-col p-6"
            >
              <div class="flex items-center justify-between gap-3">
                <span class="card-index">TECHNICAL / GUIDE</span>
                <span class="card-arrow text-slate-500">↗</span>
              </div>

              <time
                datetime={entry.data.pubDate.toISOString()}
                class="mt-6 text-xs text-slate-500"
              >
                {formatDate(entry.data.pubDate)}
              </time>

              <h2 class="mt-3 text-lg font-semibold leading-7 text-white transition group-hover:text-blue-200">
                {entry.data.title}
              </h2>

              <p class="mt-3 flex-1 text-sm leading-7 text-slate-400">
                {entry.data.description}
              </p>

              {entry.data.tags.length > 0 && (
                <div class="mt-5 flex flex-wrap gap-2">
                  {entry.data.tags.slice(0, 3).map((tag) => (
                    <span class="rounded-md border border-white/[0.08] px-2 py-1 text-xs text-slate-500">
                      {tag}
                    </span>
                  ))}
                </div>
              )}

              <span class="mt-6 text-xs text-blue-300">
                Read guide →
              </span>
            </a>
          ))}
        </div>
      ) : (
        <div class="glass-card p-8 sm:p-10">
          <p class="font-mono text-xs text-blue-300">KNOWLEDGE BASE</p>

          <h2 class="mt-4 text-xl font-semibold text-white">
            Practical knowledge, documented.
          </h2>

          <p class="mt-3 max-w-xl text-sm leading-7 text-slate-400">
            Technical guides will appear here as solutions, configurations
            and workflows are documented. Each article will focus on
            practical implementation, clear explanations and reproducible steps.
          </p>

          <a
            href="/research/"
            class="mt-6 inline-flex text-sm text-blue-300 transition hover:text-blue-200"
          >
            Explore research articles →
          </a>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
