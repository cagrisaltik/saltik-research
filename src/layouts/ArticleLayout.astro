
---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  category: string;
  tags: string[];
}

const { title, description, pubDate, category, tags } = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: pubDate.toISOString(),
  author: {
    "@type": "Organization",
    name: "Saltik Research",
    url: "https://research.cagrisaltik.com/",
  },
  publisher: {
    "@type": "Organization",
    name: "Saltik Research",
    url: "https://research.cagrisaltik.com/",
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalUrl,
  },
  articleSection: category,
  keywords: tags,
};

const dateLabel = new Intl.DateTimeFormat("en", {
  day: "numeric",
  month: "long",
  year: "numeric",
}).format(pubDate);
---

<BaseLayout
  title={`${title} — Saltik Research`}
  description={description}
  type="article"
>
<script
  type="application/ld+json"
  set:html={JSON.stringify(articleJsonLd).replace(/</g, "\\u003c")}
/>
  <article class="mx-auto max-w-6xl px-6 pb-24 pt-12 sm:pt-20">
    <a
      href="/research/"
      class="back-link text-sm text-slate-400 transition hover:text-blue-300"
    >
      <span aria-hidden="true">←</span> All research
    </a>

    <header class="mx-auto mt-12 max-w-3xl">
      <p class="eyebrow">{category}</p>

      <h1 class="hero-title mt-6 text-4xl font-semibold leading-tight text-white sm:text-5xl">
        {title}
      </h1>

      <p class="mt-6 text-lg leading-8 text-slate-400">{description}</p>

      <div class="article-meta mt-8 flex flex-wrap items-center gap-3 text-xs text-slate-500">
        <time datetime={pubDate.toISOString()}>{dateLabel}</time>
        <span aria-hidden="true">·</span>
        <span>Saltik Research</span>
        <span aria-hidden="true">·</span>
        <span data-reading-time>Calculating reading time…</span>
      </div>

      <div class="mt-6 flex flex-wrap gap-2">
        {tags.map((tag) => (
          <span
            class="rounded-md border border-white/10 bg-white/[0.03] px-3 py-1.5 font-mono text-xs text-slate-400"
          >
            #{tag}
          </span>
        ))}
      </div>
      
<div
  class="reading-progress"
  data-reading-progress
  role="progressbar"
  aria-label="Article reading progress"
  aria-valuemin="0"
  aria-valuemax="100"
  aria-valuenow="0"
>
  <span data-reading-progress-bar></span>
</div>

    </header>

    <div class="mx-auto mt-12 max-w-3xl border-t border-white/10 pt-10">
      <nav
        data-toc
        aria-label="Table of contents"
        hidden
        class="toc-panel mb-12 rounded-xl border border-white/10 bg-white/[0.02] p-5 sm:p-6"
      >
        <div class="mb-4 flex items-center gap-3">
          <span class="toc-marker" aria-hidden="true"></span>
          <h2 class="text-sm font-semibold tracking-wide text-white">
            On this page
          </h2>
        </div>

        <ol data-toc-list class="toc-list space-y-2"></ol>
      </nav>

      <div class="article-content" data-article-content>
        <slot />
      </div>

      <div class="mt-16 border-t border-white/10 pt-6">
        <a
          href="/research/"
          class="back-link inline-flex items-center gap-2 text-sm text-slate-400 transition hover:text-blue-300"
        >
          <span aria-hidden="true">←</span>
          Back to research
        </a>
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  function initializeArticle() {
    const article = document.querySelector<HTMLElement>(
      "[data-article-content]",
    );

    if (!article || article.dataset.initialized === "true") return;

    article.dataset.initialized = "true";

    // Calculate reading time from article text, excluding code blocks.
    const readingTime = document.querySelector<HTMLElement>(
      "[data-reading-time]",
    );

    if (readingTime) {
      const textCopy = article.cloneNode(true) as HTMLElement;

      textCopy
        .querySelectorAll("pre, script, style")
        .forEach((element) => element.remove());

      const words = (textCopy.textContent ?? "")
        .trim()
        .split(/\s+/)
        .filter(Boolean).length;

      const minutes = Math.max(1, Math.ceil(words / 200));

      readingTime.textContent = `${minutes} min read`;
      
    // Highlight the current section in the table of contents.
    const progress = document.querySelector<HTMLElement>(
      "[data-reading-progress]",
    );
    const progressBar = document.querySelector<HTMLElement>(
      "[data-reading-progress-bar]",
    );

    const tocLinks = Array.from(
      document.querySelectorAll<HTMLAnchorElement>(".toc-link"),
    );

    const headings = Array.from(
      article.querySelectorAll<HTMLElement>("h2, h3"),
    );

    const updateProgress = () => {
      if (!progress || !progressBar) return;

      const scrollableHeight =
        document.documentElement.scrollHeight - window.innerHeight;

      const percentage =
        scrollableHeight > 0
          ? Math.min(
              100,
              Math.max(
                0,
                (window.scrollY / scrollableHeight) * 100,
              ),
            )
          : 0;

      progressBar.style.width = `${percentage}%`;
      progress.setAttribute("aria-valuenow", String(Math.round(percentage)));
    };

    const updateActiveSection = () => {
      let activeId = "";

      for (const heading of headings) {
        if (heading.getBoundingClientRect().top <= 150) {
          activeId = heading.id;
        } else {
          break;
        }
      }

      tocLinks.forEach((link) => {
        const isActive =
          link.getAttribute("href") ===
          (activeId ? `#${encodeURIComponent(activeId)}` : "");

        if (isActive) {
          link.setAttribute("aria-current", "location");
        } else {
          link.removeAttribute("aria-current");
        }
      });
    };

    let scheduled = false;

    const updateReadingUI = () => {
      if (scheduled) return;

      scheduled = true;

      window.requestAnimationFrame(() => {
        updateProgress();
        updateActiveSection();
        scheduled = false;
      });
    };

    window.addEventListener("scroll", updateReadingUI, { passive: true });
    window.addEventListener("resize", updateReadingUI);
    updateReadingUI();

    }

    // Build a table of contents from h2 and h3 headings.
    const toc = document.querySelector<HTMLElement>("[data-toc]");
    const tocList = document.querySelector<HTMLOListElement>(
      "[data-toc-list]",
    );

    if (toc && tocList) {
      const headings = Array.from(
        article.querySelectorAll<HTMLElement>("h2, h3"),
      );

      const usedIds = new Set(
        Array.from(document.querySelectorAll<HTMLElement>("[id]"))
          .map((element) => element.id)
          .filter(Boolean),
      );

      headings.forEach((heading) => {
        if (!heading.id) {
          const baseSlug =
            heading.textContent
              ?.trim()
              .toLowerCase()
              .normalize("NFD")
              .replace(/[\u0300-\u036f]/g, "")
              .replace(/[^a-z0-9]+/g, "-")
              .replace(/^-|-$/g, "") || "section";

          let slug = baseSlug;
          let suffix = 2;

          while (usedIds.has(slug)) {
            slug = `${baseSlug}-${suffix++}`;
          }

          heading.id = slug;
          usedIds.add(slug);
        }

        heading.classList.add("article-heading");
        heading.tabIndex = -1;
        heading.style.scrollMarginTop = "2rem";

        const item = document.createElement("li");
        item.className =
          heading.tagName === "H3"
            ? "toc-item toc-item-nested"
            : "toc-item";

        const link = document.createElement("a");
        link.href = `#${encodeURIComponent(heading.id)}`;
        link.textContent = heading.textContent?.trim() || "Untitled section";
        link.className = "toc-link";

        item.appendChild(link);
        tocList.appendChild(item);
      });

      toc.hidden = headings.length === 0;
    }

    // Add a copy button to each fenced code block.
    article.querySelectorAll("pre").forEach((pre) => {
      if (pre.querySelector("[data-copy-code]")) return;

      const code = pre.querySelector("code");
      if (!code) return;

      pre.classList.add("code-block");

      const button = document.createElement("button");
      button.type = "button";
      button.dataset.copyCode = "";
      button.className = "copy-code";
      button.textContent = "Copy";
      button.setAttribute("aria-label", "Copy code to clipboard");

      button.addEventListener("click", async () => {
        const originalLabel = "Copy";

        try {
          await navigator.clipboard.writeText(code.textContent ?? "");
          button.textContent = "Copied!";
          button.classList.add("is-copied");
          button.setAttribute("aria-label", "Code copied");

          window.setTimeout(() => {
            button.textContent = originalLabel;
            button.classList.remove("is-copied");
            button.setAttribute("aria-label", "Copy code to clipboard");
          }, 1800);
        } catch {
          button.textContent = "Copy failed";
          button.setAttribute(
            "aria-label",
            "Copy failed. Select the code and copy it manually.",
          );

          window.setTimeout(() => {
            button.textContent = originalLabel;
            button.setAttribute("aria-label", "Copy code to clipboard");
          }, 2500);
        }
      });

      pre.appendChild(button);
    });
  }

  initializeArticle();
</script>

<style>
  .article-content {
    color: #cbd5e1;
    font-size: 16px;
    line-height: 1.9;
    overflow-wrap: anywhere;
  }

  .article-content :global(h1),
  .article-content :global(h2),
  .article-content :global(h3) {
    color: #f8fafc;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.025em;
  }

  .article-content :global(h1) {
    margin: 2.5rem 0 1rem;
    font-size: 2rem;
  }

  .article-content :global(h2) {
    margin: 2.5rem 0 1rem;
    font-size: 1.5rem;
  }

  .article-content :global(h3) {
    margin: 2rem 0 0.75rem;
    font-size: 1.2rem;
  }

  .article-content :global(p) {
    margin: 1.25rem 0;
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    margin: 1.25rem 0;
    padding-left: 1.5rem;
  }

  .article-content :global(ul) {
    list-style: disc;
  }

  .article-content :global(ol) {
    list-style: decimal;
  }

  .article-content :global(li) {
    margin: 0.4rem 0;
    padding-left: 0.25rem;
  }

  .article-content :global(a) {
    color: #93c5fd;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .article-content :global(strong) {
    color: #f1f5f9;
  }

  .article-content :global(code) {
    border: 1px solid rgb(148 163 184 / 15%);
    border-radius: 5px;
    background: rgb(255 255 255 / 5%);
    padding: 0.15rem 0.35rem;
    font-family: ui-monospace, monospace;
    font-size: 0.88em;
    color: #93c5fd;
  }

  .article-content :global(pre) {
    position: relative;
    margin: 1.5rem 0;
    overflow-x: auto;
    border: 1px solid rgb(148 163 184 / 15%);
    border-radius: 12px;
    background: #05070c;
    padding: 3.5rem 1.25rem 1.25rem;
  }

  .article-content :global(pre code) {
    display: block;
    min-width: max-content;
    border: 0;
    background: transparent;
    padding: 0;
    color: inherit;
    font-size: 0.875rem;
    line-height: 1.8;
  }

  .article-content :global(.copy-code) {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 1;
    border: 1px solid rgb(148 163 184 / 20%);
    border-radius: 6px;
    background: #111827;
    padding: 0.4rem 0.7rem;
    color: #cbd5e1;
    font-size: 0.75rem;
    cursor: pointer;
    transition:
      color 180ms ease,
      border-color 180ms ease,
      background 180ms ease;
  }

  .article-content :global(.copy-code:hover) {
    border-color: rgb(96 165 250 / 55%);
    background: #172554;
    color: #bfdbfe;
  }

  .article-content :global(.copy-code.is-copied) {
    border-color: rgb(52 211 153 / 40%);
    color: #6ee7b7;
  }

  .article-content :global(blockquote) {
    margin: 1.5rem 0;
    border-left: 2px solid #60a5fa;
    padding-left: 1rem;
    color: #94a3b8;
  }

  .article-content :global(hr) {
    margin: 2rem 0;
    border-color: rgb(148 163 184 / 15%);
  }

  .toc-panel[hidden] {
    display: none !important;
  }

  .toc-marker {
    width: 3px;
    height: 18px;
    border-radius: 3px;
    background: #60a5fa;
    box-shadow: 0 0 12px rgb(96 165 250 / 35%);
  }

  .toc-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .toc-item {
    margin: 0;
    padding: 0;
  }

  .toc-item-nested {
    padding-left: 1rem;
  }

  .toc-link {
    display: block;
    border-left: 1px solid rgb(148 163 184 / 15%);
    padding: 0.35rem 0 0.35rem 0.85rem;
    color: #94a3b8;
    font-size: 0.875rem;
    line-height: 1.6;
    text-decoration: none;
    transition:
      color 180ms ease,
      border-color 180ms ease;
  }

  .toc-link:hover,
  .toc-link:focus-visible {
    border-left-color: #60a5fa;
    color: #bfdbfe;
  }

  .back-link:focus-visible,
  .copy-code:focus-visible {
    outline: 2px solid #60a5fa;
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .toc-link,
    .copy-code {
      transition: none;
    }
  }
  
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 100;
    width: 100%;
    height: 3px;
    background: rgb(148 163 184 / 8%);
    pointer-events: none;
  }

  .reading-progress span {
    display: block;
    width: 0;
    height: 100%;
    background: linear-gradient(90deg, #2563eb, #60a5fa, #818cf8);
    box-shadow: 0 0 12px rgb(59 130 246 / 35%);
    transition: width 80ms linear;
  }

  .toc-link[aria-current="location"] {
    border-left-color: #60a5fa;
    background: rgb(59 130 246 / 7%);
    color: #bfdbfe;
  }

</style>
