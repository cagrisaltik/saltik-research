
---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
}

const {
  title = "Saltik Research — Independent Security Research",
  description = "Independent security research, CTF write-ups and technical experiments.",
  type = "website",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#080b12" />

  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />

  <meta property="og:type" content={type} />
  <meta property="og:site_name" content="Saltik Research" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
  <meta property="og:locale" content="en_US" />

  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  <title>{title}</title>
</head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
